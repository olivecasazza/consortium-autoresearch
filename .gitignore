# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.so
*.dylib

# Nix
/result
/result-*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.fastembed_cache/
.venv
.results/
.env.local

# Test reports
test-reports/

# Node.js
node_modules/
.npm/
.nvmrc
yarn.lock

# Direnv / Hermes
.direnv/
.hermes/
test_ini.rs
results/

# Scratch dir for harness/scorecard_guard.py's self-test. It cleans up after
# itself, but a killed run should not leave a tree behind.
scorecard-guard-probe-*/

# Docker test artifacts
tests/docker/ssh/
tests/docker/docker-compose.generated.yml
.pre-commit-config.yaml

# autoresearch local config
autoresearch/.env
autoresearch/logs/
autoresearch/queue/in-progress/*.task.toml
autoresearch/queue/abandoned/*.task.toml

# Agent worktrees — created by Claude Code via .claude/worktrees/.
# These are local working copies that should never be tracked.
.claude/worktrees/
.claire/

# Backup files from autoresearch's accountant agent.
*.bak.*
